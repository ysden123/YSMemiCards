<Window x:Class="YSMemiCardsApp.Controls.ConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YSMemiCardsApp.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Configuration" Height="220" Width="270">
    <DockPanel>
        <Grid Margin="5" DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="First days:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FirstDays, Mode=TwoWay}" PreviewTextInput="TxtNumber_PreviewTextInput"
                     DataObject.Pasting="TxtNumber_Pasting" VerticalAlignment="Center" Margin="5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Second days:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SecondDays, Mode=TwoWay}"  PreviewTextInput="TxtNumber_PreviewTextInput"
                     DataObject.Pasting="TxtNumber_Pasting" VerticalAlignment="Center" Margin="5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Third days:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ThirdDays, Mode=TwoWay}"  PreviewTextInput="TxtNumber_PreviewTextInput"
                     DataObject.Pasting="TxtNumber_Pasting" VerticalAlignment="Center" Margin="5"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5" DockPanel.Dock="Bottom" Height="30">
            <Button Content="OK" Width="75" Margin="5" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="75" Margin="5" IsCancel="True"/>
        </StackPanel>
    </DockPanel>
</Window>

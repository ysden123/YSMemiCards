<UserControl x:Class="YSMemiCardsApp.Controls.CardListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YSMemiCardsApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <GroupBox Header="Card List" Margin="10">
        <DockPanel>
            <ListView x:Name="cardListView" DockPanel.Dock="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Height="300" SelectionChanged="CardListView_SelectionChanged" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Word" DisplayMemberBinding="{Binding Word}" Width="200"/>
                        <GridViewColumn Header="Translations" DisplayMemberBinding="{Binding Translations}" Width="400"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5" DockPanel.Dock="Bottom" Height="30">
                <Button x:Name="ButtonAdd" Content="Add" Width="75" Margin="5" Click="AddButton_Click"/>
                <Button x:Name="ButtonEdit" Content="Edit" Width="75" Margin="5" Click="EditButton_Click" IsEnabled="False"/>
                <Button x:Name="ButtonDelete" Content="Delete" Width="75" Margin="5" Click="DeleteButton_Click" IsEnabled="False"/>
                <Button x:Name="ButtonSave" Content="Save" Width="75" Margin="5" Click="SaveButton_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </GroupBox>
</UserControl>

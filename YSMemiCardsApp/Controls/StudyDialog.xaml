<Window x:Class="YSMemiCardsApp.Controls.StudyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YSMemiCardsApp.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Study" Height="450" Width="800">
    <Border BorderBrush="Black" BorderThickness="1" Padding="10" Width="280" Height="190">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Total Cards" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalCardsTextBlock" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Margin="10,0,0,0"/>
            <Label Grid.Row="1" Grid.Column="0" Content="Cards to study" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CardsToStudyTextBlock" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Margin="10,0,0,0"/>
            <Button Grid.Row="2" Grid.Column="2" x:Name="StartStudySessionButton" Content="Start Study Session" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" Height="40" Click="StartStudySession_Click"/>
        </Grid>
    </Border>
</Window>

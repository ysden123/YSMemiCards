<Window x:Class="YSMemiCardsApp.Controls.ResponseEvaluationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YSMemiCardsApp.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Response Evaluation" Height="150" Width="639">
    <DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20" DockPanel.Dock="Top">
            <Label Content="Translations:" Margin="5"/>
            <TextBox Text="{Binding Translations}" Margin="5" Width="500"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Bottom" Height="30">
            <Button Content="Hard" Width="75" Margin="5" IsDefault="True" Click="HardButton_Click"/>
            <Button Content="Medium" Width="75" Margin="5" IsCancel="True" Click="MediumButton_Click"/>
            <Button Content="Easy" Width="75" Margin="5" Click="EasyButton_Click"/>
        </StackPanel>
    </DockPanel>
</Window>

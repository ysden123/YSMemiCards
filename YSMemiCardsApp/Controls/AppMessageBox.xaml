<Window x:Class="YSMemiCardsApp.Controls.AppMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YSMemiCardsApp.Controls"
        mc:Ignorable="d"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="AppMessageBox" Height="361" Width="722">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <Button Content="ОК" Width="90" HorizontalAlignment="Right" IsDefault="True" Click="OkButton_Click"/>
    </StackPanel>
</Window>
